# Browser configuration. Production defaults to same-origin Vercel Functions,
# so no CA, Gateway, route, or contract address is compiled into the site.
VITE_RUNTIME_STATUS_ENDPOINT=/api/runtime
VITE_ELIGIBILITY_ENDPOINT=/api/eligibility
VITE_BUY_QUOTE_ENDPOINT=/api/quote
VITE_MEMBER_STATS_ENDPOINT=/api/members
VITE_HOLDER_STATS_ENDPOINT=/api/holders
VITE_HOLDER_STOCK_STATS_ENDPOINT=/api/holder-stock
VITE_LOG_CONFIRMATIONS=12

# Public-address values mirror the checked-in Production V2 manifest. They are
# consistency checks only and can never override or activate that release record.
REGISTRY_ADDRESS=0x2C2cAF5D52B5e6156f65030b92163B99FccA927e
PROJECT_AUTHORITY_ADDRESS=0x1373910FB6A73b640CdFBd980a776ED88f924247
STOCK_TOKEN_ADDRESS=0xD5f3879160bc7c32ebb4dC785F8a4F505888de68
CHAIN_QUOTER_ADDRESS=0x33e885eD0Ec9bF04EcfB19341582aADCb4c8A9E7

# Required Production consistency pins for the manifest-bound stack.
GATEWAY_IMPLEMENTATION_ADDRESS=0xFbB603112215dF60C1108fABa0f089e77bBa6D8F
GATEWAY_IMPLEMENTATION_CODE_HASH=0xc54c1db34171e6d63e9e763d2435c0211185736bc977744571c93bf815b87b21
ELIGIBILITY_CHECKER_ADDRESS=0xBB9187a026E4b65957c53766b0a3Bf6Ac11BC491
ELIGIBILITY_POLICY_HASH=0xb4367ebc10997be2f01f45b58197b507e9637ee66570eaf9b329cd3455b834cf

# Server-only runtime. Never prefix secrets with VITE_.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com
VERIFY_STOCK_ASSET_REGISTRY=true
STOCK_ASSET_REGISTRY_TIMEOUT_MS=5000
STOCK_ASSET_REGISTRY_MAX_BYTES=200000
ELIGIBILITY_SIGNER_PRIVATE_KEY=
ELIGIBILITY_SIGNING_SECRET=

# Production is fail-closed unless an independent sanctions/KYC provider is
# configured. geo_attestation remains a development-only mode.
ELIGIBILITY_PROVIDER_MODE=external
ELIGIBILITY_PROVIDER_URL=
ELIGIBILITY_PROVIDER_API_KEY=
ELIGIBILITY_PROVIDER_REQUEST_SECRET=
ELIGIBILITY_BLOCKED_COUNTRIES=US,CA,GB,CH,CU,BY,IR,KP,RU,SY,UA,SS,SD,MM,VE
ELIGIBILITY_TTL_SECONDS=300

# Quote, amount and operational limits.
DEFAULT_SLIPPAGE_BPS=200
MAX_SLIPPAGE_BPS=500
QUOTE_TTL_SECONDS=45
MIN_BUY_WEI=100000000000000
MAX_BUY_WEI=10000000000000000000
LOG_CONFIRMATIONS=12
CORS_ALLOWED_ORIGINS=https://degen-pension.vercel.app
RPC_TIMEOUT_MS=8000
RUNTIME_CACHE_SECONDS=15
STATS_CACHE_SECONDS=30
MEMBER_MAX_SCAN_BLOCKS=250000
MEMBER_LOG_CHUNK=20000

# Durable public statistics. Production always requires this signed indexer;
# the bounded RPC scanner is development-only and opt-in.
STATS_INDEXER_URL=
STATS_INDEXER_API_KEY=
STATS_INDEXER_HMAC_SECRET=
STATS_INDEXER_TIMEOUT_MS=5000
STATS_INDEXER_MAX_AGE_SECONDS=120
ALLOW_BOUNDED_STATS_FALLBACK=false

# Shared rate-limit decision service. It must return signed decisions using the
# response contract documented in docs/PRODUCTION_API.md.
RATE_LIMIT_PROVIDER_URL=
RATE_LIMIT_PROVIDER_TOKEN=
RATE_LIMIT_PROVIDER_HMAC_SECRET=
RATE_LIMIT_TIMEOUT_MS=2000

# Signed operational alert sink. Missing monitoring keeps Production NOT_READY.
MONITORING_WEBHOOK_URL=
MONITORING_WEBHOOK_TOKEN=
MONITORING_WEBHOOK_HMAC_SECRET=
MONITORING_TIMEOUT_MS=2000
OPERATIONS_HEALTH_CACHE_SECONDS=15

# Independent contract audit evidence. Runtime downloads the PDF and verifies
# this digest; filling arbitrary metadata does not make the check pass.
INDEPENDENT_AUDIT_REPORT_URL=
INDEPENDENT_AUDIT_SHA256=
INDEPENDENT_AUDIT_FIRM=
INDEPENDENT_AUDIT_COMPLETED_AT=
INDEPENDENT_AUDIT_TIMEOUT_MS=5000
INDEPENDENT_AUDIT_MAX_BYTES=5000000
