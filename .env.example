# Browser configuration. Production defaults to same-origin Vercel Functions,
# so no CA, Gateway, route, or contract address is compiled into the site.
VITE_RUNTIME_STATUS_ENDPOINT=/api/runtime
VITE_ELIGIBILITY_ENDPOINT=/api/eligibility
VITE_BUY_QUOTE_ENDPOINT=/api/quote
VITE_MEMBER_STATS_ENDPOINT=/api/members
VITE_HOLDER_STATS_ENDPOINT=/api/holders
VITE_LOG_CONFIRMATIONS=12

# The only contract pointer the server needs. Set after ProductionMarketActivator
# is deployed; the official CA and all current market addresses are read onchain.
REGISTRY_ADDRESS=
PROJECT_AUTHORITY_ADDRESS=0x1373910FB6A73b640CdFBd980a776ED88f924247
STOCK_TOKEN_ADDRESS=0xD5f3879160bc7c32ebb4dC785F8a4F505888de68
CHAIN_QUOTER_ADDRESS=0x33e885eD0Ec9bF04EcfB19341582aADCb4c8A9E7

# Optional pinning after predeployment verification.
GATEWAY_IMPLEMENTATION_ADDRESS=
GATEWAY_IMPLEMENTATION_CODE_HASH=
ELIGIBILITY_CHECKER_ADDRESS=
ELIGIBILITY_POLICY_HASH=0xb4367ebc10997be2f01f45b58197b507e9637ee66570eaf9b329cd3455b834cf

# Server-only runtime. Never prefix secrets with VITE_.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com
ELIGIBILITY_SIGNER_PRIVATE_KEY=
ELIGIBILITY_SIGNING_SECRET=

# Minimal-cost built-in control: trusted Vercel country header + self-attestation.
# Set mode=external and provider values to add sanctions/KYC screening.
ELIGIBILITY_PROVIDER_MODE=geo_attestation
ELIGIBILITY_PROVIDER_URL=
ELIGIBILITY_PROVIDER_API_KEY=
ELIGIBILITY_PROVIDER_REQUEST_SECRET=
ELIGIBILITY_BLOCKED_COUNTRIES=US,CA,GB,CH,CU,BY,IR,KP,RU,SY,UA,SS,SD,MM,VE
ELIGIBILITY_TTL_SECONDS=300

# Quote, amount and operational limits.
DEFAULT_SLIPPAGE_BPS=200
MAX_SLIPPAGE_BPS=500
QUOTE_TTL_SECONDS=45
MIN_BUY_WEI=100000000000000
MAX_BUY_WEI=10000000000000000000
LOG_CONFIRMATIONS=12
CORS_ALLOWED_ORIGINS=https://degen-pension.vercel.app
RPC_TIMEOUT_MS=8000
RUNTIME_CACHE_SECONDS=15
STATS_CACHE_SECONDS=30
MEMBER_MAX_SCAN_BLOCKS=250000
MEMBER_LOG_CHUNK=20000
